{
  "name": "terrella",
  "version": "0.2.0",
  "description": "An interactive globe for the web. Highlight countries and regions, place markers, choose a render style.",
  "keywords": [
    "globe",
    "map",
    "d3-geo",
    "orthographic",
    "topojson",
    "canvas",
    "choropleth",
    "regions",
    "countries",
    "visualisation"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./terrella.css": "./dist/terrella.css"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && cp src/terrella.css dist/terrella.css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "demo": "npm run build && python3 -m http.server 8080",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.10.0",
    "@types/topojson-client": "^3.1.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DamilolaEmmnauel/terrella.git"
  },
  "homepage": "https://github.com/DamilolaEmmnauel/terrella#readme",
  "engines": {
    "node": ">=18"
  }
}
